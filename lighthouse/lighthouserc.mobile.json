{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --strictPort",
      "startServerReadyPattern": "127.0.0.1:4173",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/nfts/emerald-ape-042"
      ],
      "numberOfRuns": 3,
      "settings": {}
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.95,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.95,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse/reports/mobile",
      "reportFilenamePattern": "%%PATHNAME%%-%%DATETIME%%.report.%%EXTENSION%%"
    }
  }
}
